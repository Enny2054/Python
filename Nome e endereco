import tkinter as tk

def salvar_nome_endereco():
    nome = entry_nome.get()
    endereco = entry_endereco.get() 
    if nome and endereco: 
        with open("dados.txt", "a") as arquivo:
            arquivo.write(nome + " - " + endereco + "\n") 
        label_status.config(text=f'Nome "{nome}" e Endereço "{endereco}" salvos com sucesso!', fg='green')
    else: 
        label_status.config(text="Por favor, preencha tanto o nome quanto o endereço.", fg='red')

root = tk.Tk()
root.title("Dados de Cadastro")
root.geometry("500x300")

label_instrucao_nome = tk.Label(root, text="Digite um nome:")
label_instrucao_nome.pack(pady=10)

entry_nome = tk.Entry(root)  
entry_nome.pack(pady=5)

label_instrucao_endereco = tk.Label(root, text="Digite o endereço:")
label_instrucao_endereco.pack(pady=10)

entry_endereco = tk.Entry(root) 
entry_endereco.pack(pady=5)

label_status = tk.Label(root, text="")
label_status.pack(pady=5)

botao_salvar = tk.Button(root, text="Salvar", command=salvar_nome_endereco)
botao_salvar.pack(pady=10)

root.mainloop()
